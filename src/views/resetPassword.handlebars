<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/css/forgotPassword.css" />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
  </head>

  <body>

    <div class="form-container">

      <div class="col col-2">

        <form class="login-form" id="resetPasswordForm">

          <div class="form-title">
            <span>Reset Password</span>
          </div>

          <div class="form-inputs">

            <div class="input-box">
              <input
                type="email"
                name="email"
                placeholder="Email"
                class="input-field"
              />
              <i class="bx bx-user icon"></i>
            </div>

            <div class="input-box">
              <button class="input-submit" type="submit">
                <span>Send recuperation mail</span>
                <i class="bx bx-right-arrow-alt"></i>
              </button>
              <p id="login-error-message">Password or Email incorrect</p>
            </div>

          </div>

          <div class="social-login">

            <a href="/api/sessions/github"><i class="bx bxl-github"></i></a>
            <i class="bx bxl-google"></i>
            <i class="bx bxl-facebook"></i>
            <i class="bx bxl-twitter"></i>

          </div>

        </form>
      </div>

    </div>

    <script src="js/resetPassword.js"></script>

  </body>

</html>