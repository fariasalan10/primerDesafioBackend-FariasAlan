  <html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/products.css" />
  </head>
  <di>
    <nav
      class="navbar bg-dark navbar-expand-lg bg-body-tertiary"
      data-bs-theme="dark"
    >
      <div class="container-fluid">
        <a class="navbar-brand" href="./">
          <img
            src="https://www.kindpng.com/picc/m/28-285204_transparent-background-shopping-cart-icon-png-png-download.png"
            alt="logo carrito"
            width="30"
            height="30"
          />
        </a>
        <a class="navbar-brand" href="./">Ecommerce</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">


            <li class="nav-item">
              <a class="nav-link" href="./products">
                Productos
              </a>

            </li>
            <li class="nav-item">
              <a class="nav-link" href="/api/sessions/logout">Logout</a>
            </li>
          </ul>

         
        </div>
      </div>
    </nav>

<div class="products-container" id="productos" >
{{#each products}}
 <article class="container1">
        <div class="producto card1">
          <div class="contenido">
            <div class="div-img"><img src="{{this.thumbnail}}" alt="{{this.thumbnail}}" ></div>
            
            <a href="api/products/{{this._id}}"><h3 class="card-title">{{this.title}}</h3></a>
            <p class="card-text">ID: {{this._id}}</p>

            <p class="card-text">{{this.description}}</p> 
            <p>${{this.price}}</p>
            <p class="card-text">Stock: {{this.stock}}</p>
            <a onclick="addToCart('{{../user.cart}}','{{this._id}}')" class="btnAgregar botonCarrito" >Agregar al carrito</a>
          </div>
        </div>
      </article>

   {{/each}}
</div>



   <section class="ocultar">
      <h1 id="ocultar__h1"> 
        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" fill="currentColor" class="bi bi-cart2" viewBox="0 0 16 16">
  <path d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5M3.14 5l1.25 5h8.22l1.25-5zM5 13a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0m9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0"/>
</svg>
      </h1>
      <div id="scroll">
        <div id="carrito">
          {{#each cart.products}}
            <div class="card" style="width: 15rem;">
              <img
                src="{{this.product.thumbnail}}"
                class="card-img-top"
                alt="{{this.product.title}}"
              />
              <div class="card-body">
                <h5 class="card-title">{{this.product.title}} </h5>
                <p class="card-text"> {{this.product.description}}</p>
                <p class="card-text">Cantidad: {{this.quantity}}</p>
                <p class="card-text">${{this.product.price}}</p>
                <a
                  href="#"
                  class="btnQuitar botonCarrito"
                  onclick="deleteFromCart('{{../user.cart}}','{{this.product._id}}')"
                >Quitar del carrito</a>
              </div>

            </div>

          {{/each}}
        </div>
      </div>
      <button class="botonCarrito" onclick="purchaseCart('{{user.cart}}')">Purchase Cart</button>
    </section>

<div >
    {{#if hasPrevPage}}
        <a href="{{prevLink}}"><button >Prev</button></a>
    {{else}}
        <button disabled>Prev</button>
    {{/if}}

    {{#if hasNextPage}}
   
        <a href="{{nextLink}}"><button >Next</button></a>
    </button>
    {{else}}
        <button class='btnPageDisabled' disabled>Next</button>
    {{/if}}
</div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
<script src="/js/products.js"></script>

  </body>
  </html>

