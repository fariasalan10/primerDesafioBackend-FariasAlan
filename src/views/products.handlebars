  <html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/products.css" />

  </head>

  <body>

    <nav
      class="navbar colorNavbar navbar-expand-lg"
    >
      <div class="container-fluid">
        <a class="navbar-brand" href="./">
          <img
            src="/assets/cart.png"
            alt="logo carrito"
            width="25"
            height="25"
          />
        </a>
        <a class="navbar-brand" style="color: white;" href="./">Ecommerce</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
        <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" style="display: flex ; justify-content: center; color: white;"  href="./products">
                Productos
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" style="display: flex ; justify-content: center; color: white;" href="/api/sessions/logout">Logout</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

<div class="container">
      <header>
        <div class="title">PRODUCT LIST</div>
        <div class="icon-cart"> 
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4h1.5L9 16m0 0h8m-8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-8.5-3h9.25L19 7H7.312"/>
          </svg>
          <span>{{cart.products.length}}</span>
        </div>
      </header>

      <div class="listProduct">
        {{#each products}}
        <div class="item">
          <img src="{{this.thumbnail}}" alt="{{this.thumbnail}}" >
          <a href="api/products/{{this._id}}"><h2>{{this.title}}</h2></a>
          <p class="card-text">{{this.description}}</p>
          <p class="card-text">Stock: {{this.stock}}</p>
          <div class="price">${{this.price}}</div>
          <button class="addCart" onclick="addToCart('{{../user.cart}}','{{this._id}}')">
            Add To Cart
          </button>
        </div>
        {{/each}}
      </div>

      <div class="cartTab hiddenCart">
        <h1>Shopping Cart</h1>
        <div class="listCart">
          {{#each cart.products}}
          <div class="item">
            <div class="image">
              <img src="{{this.product.thumbnail}}" alt="{{this.product.title}}" />
            </div>
            <div class="name">
              <h2>{{this.product.title}}</h2>
            </div>
            <div class="totalPrice">
              <h2>${{this.product.price}}</h2>
            </div>
            <div class="quantity">
              <span>{{this.quantity}}</span>
            </div>
            <div class="remove">
              <a class="minus" onclick="deleteFromCart('{{../user.cart}}','{{this.product._id}}')">x</a>
            </div>
          </div>
          {{/each}}
        </div>
        <div class="total">
            <h2>Total: ${{total}}</h2>
        </div>
        <div class="btn">
          <button class="close">CLOSE</button>
          {{!-- <button class="pay-button">CHECK OUT</button> --}}
          <button class="checkOut" onclick="purchaseCart('{{user.cart}}')">CHECK OUT</button>
        </div>
      </div>

    </div>


    {{!-- {{#if hasPrevPage}}
        <a href="{{prevLink}}"><button >Prev</button></a>
    {{else}}
        <button disabled>Prev</button>
    {{/if}}

    {{#if hasNextPage}}

        <a href="{{nextLink}}"><button >Next</button></a>
    </button>
    {{else}}
        <button class='btnPageDisabled' disabled>Next</button>
    {{/if}} --}}


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
></script>
<script src="/js/products.js"></script>

  </body>
  </html>

