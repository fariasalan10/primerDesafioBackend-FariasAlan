<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/css/products.css" />

  </head>
  <body>

    <nav
      class="navbar bg-dark navbar-expand-lg bg-body-tertiary"
      data-bs-theme="dark"
    >
      <div class="container-fluid">
        <a class="navbar-brand" href="./">
          <img
            src="https://www.kindpng.com/picc/m/28-285204_transparent-background-shopping-cart-icon-png-png-download.png"
            alt="logo carrito"
            width="30"
            height="30"
          />
        </a>
        <a class="navbar-brand" href="./">Ecommerce</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">

            <li class="nav-item">
              <a class="nav-link" href="/products">
                Productos
              </a>
            </li>

          </ul>

        </div>
      </div>
    </nav>

    <div class="container__frase upper">
      <h1 class="container__frase--h1">
        Tu próximo producto está en este Ecommerce
      </h1>
    </div>

    <div class="container__parraf">
      <p class="container__parraf--p">
        Tus productos al mejor precio...
      </p>
    </div>

    <div class="container__img-home">

      {{#each products}}
        <img
          src="{{this.thumbnail}}"
          alt="{{this.title}}"
          class="container__img"
        />

      {{/each}}

    </div>

    <section class="ocultar">
      <h1 id="ocultar__h1">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="45"
          height="45"
          fill="currentColor"
          class="bi bi-person-check"
          viewBox="0 0 16 16"
        >
          <path
            d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7m1.679-4.493-1.335 2.226a.75.75 0 0 1-1.174.144l-.774-.773a.5.5 0 0 1 .708-.708l.547.548 1.17-1.951a.5.5 0 1 1 .858.514M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0M8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4"
          />
          <path
            d="M8.256 14a4.5 4.5 0 0 1-.229-1.004H3c.001-.246.154-.986.832-1.664C4.484 10.68 5.711 10 8 10q.39 0 .74.025c.226-.341.496-.65.804-.918Q8.844 9.002 8 9c-5 0-6 3-6 4s1 1 1 1z"
          />
        </svg>
      </h1>
      <div id="scroll">
        <div id="carrito">

          <div class="card" style="width: 15rem;">

            <div class="card-body">
              <h5 class="card-title">{{user.name}} </h5>
              <p class="card-text"> {{user.email}}</p>
              <p class="card-text">Edad: {{user.age}}</p>
              <p class="card-text">Cart id: {{user.cart}}</p>
              <p class="card-text">Rol: {{user.role}}</p>
            </div>
            <button class="botonCarrito"><a
                href="/api/sessions/logout"
              >Logout</a></button>
          </div>

        </div>

      </div>

    </section>

    <div class="contenedor3">
      <h3 class="contenedor3__frase">Ecommerce te ofrece</h3>
      <p class="contenedor3__parrafo">Productos usados seleccionados o nuevos en
        caja sellados.<br />
        Conocé nuestro PLAN CANJE, dejá tu usado y llevate tu nuevo.
        <br />
        Garantía de fábrica + garantía de 3 meses por Ecommerce.<br />
        Todos los medios de pago.</p>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="/js/products.js"></script>
  </body>
</html>